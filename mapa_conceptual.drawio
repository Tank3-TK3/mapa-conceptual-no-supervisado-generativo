<mxfile host="Electron" type="device"><diagram id="mapa" name="Mapa conceptual"><mxGraphModel dx="1640" dy="920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="raiz" value="&lt;b&gt;Aprendizaje sin etiquetas&lt;/b&gt;&lt;br&gt;Solo se observa x; se estudia la estructura de p(x)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0f2744;strokeColor=#0f2744;strokeWidth=3;fontColor=#ffffff;fontSize=28;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="800" height="110" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;APRENDIZAJE NO SUPERVISADO&lt;/b&gt;&lt;br&gt;Describe la estructura de los datos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dbe8f8;strokeColor=#2a78d6;strokeWidth=3;fontColor=#0b0b0b;fontSize=26;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="690" height="110" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;MODELOS GENERATIVOS&lt;/b&gt;&lt;br&gt;Aprenden p(x) para crear datos nuevos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fde4d8;strokeColor=#eb6834;strokeWidth=3;fontColor=#0b0b0b;fontSize=26;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="190" width="690" height="110" as="geometry"/></mxCell><mxCell id="km" value="&lt;b&gt;K-means&lt;/b&gt;&lt;br&gt;&lt;i&gt;Agrupamiento&lt;/i&gt;&lt;br&gt;&lt;br&gt;Minimiza la inercia&lt;br&gt;Σ‖x − μ&lt;sub&gt;k&lt;/sub&gt;‖²&lt;br&gt;&lt;br&gt;&lt;b&gt;Mide:&lt;/b&gt; inercia, silueta&lt;br&gt;&lt;b&gt;Límite:&lt;/b&gt; elegir k e inicialización" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dbe8f8;strokeColor=#2a78d6;strokeWidth=3;fontColor=#0b0b0b;fontSize=24;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="400" width="300" height="340" as="geometry"/></mxCell><mxCell id="pca" value="&lt;b&gt;PCA&lt;/b&gt;&lt;br&gt;&lt;i&gt;Reducción de dimensionalidad&lt;/i&gt;&lt;br&gt;&lt;br&gt;Maximiza la varianza proyectada&lt;br&gt;&lt;br&gt;&lt;b&gt;Mide:&lt;/b&gt; varianza explicada&lt;br&gt;&lt;b&gt;Límite:&lt;/b&gt; solo lineal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dbe8f8;strokeColor=#2a78d6;strokeWidth=3;fontColor=#0b0b0b;fontSize=24;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="400" width="300" height="340" as="geometry"/></mxCell><mxCell id="gan" value="&lt;b&gt;GAN&lt;/b&gt;&lt;br&gt;&lt;i&gt;Síntesis adversarial&lt;/i&gt;&lt;br&gt;&lt;br&gt;Juego minimax entre generador y discriminador&lt;br&gt;&lt;br&gt;&lt;b&gt;Mide:&lt;/b&gt; IS, FID&lt;br&gt;&lt;b&gt;Límite:&lt;/b&gt; colapso modal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fde4d8;strokeColor=#eb6834;strokeWidth=3;fontColor=#0b0b0b;fontSize=24;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="400" width="300" height="340" as="geometry"/></mxCell><mxCell id="vae" value="&lt;b&gt;VAE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Inferencia probabilística&lt;/i&gt;&lt;br&gt;&lt;br&gt;Maximiza la ELBO (reconstrucción − KL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Mide:&lt;/b&gt; ELBO&lt;br&gt;&lt;b&gt;Límite:&lt;/b&gt; muestras borrosas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fde4d8;strokeColor=#eb6834;strokeWidth=3;fontColor=#0b0b0b;fontSize=24;fontFamily=Helvetica;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="300" height="340" as="geometry"/></mxCell><mxCell id="latente" value="&lt;b&gt;Representación interna (espacio latente)&lt;/b&gt;&lt;br&gt;K-means: clúster discreto · PCA: ejes lineales&lt;br&gt;GAN: ruido z · VAE: distribución q(z|x)&lt;br&gt;&lt;i&gt;PCA probabilística = modelo latente lineal&lt;/i&gt;" style="roun